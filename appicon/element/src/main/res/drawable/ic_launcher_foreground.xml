<!--
  Launcher icon foreground: the same K as the onboarding mark.

  Adaptive icons only guarantee the central 66 of the 108dp viewport is visible - launchers
  mask and parallax the rest - so the glyph is kept inside roughly 34..74 on both axes and
  centred on 54.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M38,32 L38,76 M38,54 L70,32 M38,54 L70,76"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="11" />
</vector>
