<!--
  Themed-icon variant. The launcher recolours this itself, so the only thing that matters is
  the silhouette - the colour below is a placeholder that never reaches the screen. Drawn a
  little heavier than the colour foreground because themed icons are rendered flat, with no
  background disc to separate the strokes.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M38,32 L38,76 M38,54 L70,32 M38,54 L70,76"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="12" />
</vector>
