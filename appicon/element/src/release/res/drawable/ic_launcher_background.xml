<!--
  Release icon background. Each build type keeps its own colour so the three installs stay
  distinguishable in the launcher - this is the brand violet, debug and nightly are darker.
  The gradient runs corner to corner across the full 108dp because launcher masks crop the
  edges and a centred one would look off under a circle mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item
                    android:color="#FF8B6DF0"
                    android:offset="0" />
                <item
                    android:color="#FF5B31CC"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
